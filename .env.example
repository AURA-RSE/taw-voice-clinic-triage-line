# ---- Vapi (dashboard.vapi.ai > API Keys > Private key) ----
VAPI_API_KEY=your_vapi_private_key
# Shared secret sent by Vapi on every server request (X-Vapi-Secret). Put the same value in the
# "Handle Vapi Message" node in n8n (VAPI_SHARED_SECRET). Generate with: openssl rand -hex 24
VAPI_SHARED_SECRET=your_random_secret
# Model used by the assistant (OpenAI via Vapi, no own key needed on the Vapi trial)
OPENAI_MODEL=gpt-4o-mini

# ---- n8n ----
# Production URL of the "Vapi Server Webhook" node (workflow must be active)
N8N_VAPI_WEBHOOK_URL=https://your-instance.app.n8n.cloud/webhook/vapi/clinic-triage

# ---- Clinic ----
CLINIC_NAME=Harbourview Family Clinic
CLINIC_TIMEZONE=Africa/Lagos
EMERGENCY_NUMBER=112

# ---- Department transfer numbers ----
# TEST NUMBERS ONLY: your own phone or teammates who agreed to receive test calls.
# On a Twilio trial these must also be Verified Caller IDs. E.164 format.
DEPT_APPOINTMENTS_NUMBER=+15550100101
DEPT_BILLING_NUMBER=+15550100102
DEPT_PHARMACY_NUMBER=+15550100103
DEPT_LAB_NUMBER=+15550100104
DEPT_RECORDS_NUMBER=+15550100105
DEPT_NURSE_NUMBER=+15550100106

# ---- Twilio (inbound number imported into Vapi) ----
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15550100100

# ---- Google (OAuth credentials live in n8n's credential store) ----
GOOGLE_SHEET_ID=your_google_sheet_id
GOOGLE_CALENDAR_ID=your_calendar_id@group.calendar.google.com

# These values document what each service needs. Real values go in .env (git-ignored)
# and in n8n/Vapi credential stores, never in a committed file.
